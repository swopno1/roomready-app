<?xml version="1.0" encoding="utf-8"?>
<!-- Static base for the animated splash mark. Initial ("from") values are
     baked in; splash_mark_animated.xml drives them to their resting state.
     Never referenced directly below API 31 (see values/themes.xml). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Mint halo: fades in -->
    <path
        android:name="halo"
        android:fillAlpha="0"
        android:pathData="M18,18h72v72h-72z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="56"
                android:centerY="54"
                android:gradientRadius="32"
                android:type="radial">
                <item
                    android:color="#3300FF94"
                    android:offset="0.0" />
                <item
                    android:color="#1400EEDA"
                    android:offset="0.55" />
                <item
                    android:color="#000F172A"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Door group: settles from 88% scale -->
    <group
        android:name="door"
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.88"
        android:scaleY="0.88">

        <!-- Architectural doorway frame -->
        <path
            android:fillColor="#091124"
            android:pathData="M37,31 L65,31 Q68,31 68,34 L68,74 Q68,77 65,77 L37,77 Q35,77 35,75 L35,33 Q35,31 37,31 Z"
            android:strokeWidth="1.5"
            android:strokeColor="#334155" />

        <!-- White door slab slightly ajar -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M35.5,32 L58.5,36.5 L58.5,71.5 L35.5,76 Z"
            android:strokeWidth="2.2"
            android:strokeColor="#0F172A"
            android:strokeLineJoin="round" />

        <!-- Door latch handle -->
        <path
            android:fillColor="#0F172A"
            android:pathData="M54,54 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0" />
    </group>

    <!-- Ink keyline halo under check: draws in -->
    <path
        android:name="haloCheck"
        android:fillColor="#00000000"
        android:pathData="M48,54 L56,62 L73.5,42.5"
        android:strokeWidth="8.0"
        android:strokeColor="#0F172A"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:trimPathEnd="0" />

    <!-- Mint gradient checkmark: draws in -->
    <path
        android:name="mintCheck"
        android:fillColor="#00000000"
        android:pathData="M48,54 L56,62 L73.5,42.5"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:trimPathEnd="0">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="73.5"
                android:endY="42.5"
                android:startX="48"
                android:startY="60"
                android:type="linear">
                <item
                    android:color="#00FF94"
                    android:offset="0.0" />
                <item
                    android:color="#00EEDA"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
