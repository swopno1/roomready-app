    <!-- Ink keyline halo under check -->
    <path
        android:fillColor="#00000000"
        android:pathData="M48,54 L56,62 L73.5,42.5"
        android:strokeWidth="8.0"
        android:strokeColor="#0F172A"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Mint gradient checkmark -->
    <path
        android:fillColor="#00000000"
        android:pathData="M48,54 L56,62 L73.5,42.5"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="73.5"
                android:endY="42.5"
                android:startX="48"
                android:startY="60"
                android:type="linear">
                <item
                    android:color="#00FF94"
                    android:offset="0.0" />
                <item
                    android:color="#00EEDA"
                    android:offset="1.0" />
