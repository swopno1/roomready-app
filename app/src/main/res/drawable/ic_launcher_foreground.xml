<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Architectural doorway frame & threshold inside 66dp safe zone [21..87] -->
    <path
        android:fillColor="#091124"
        android:pathData="M36,28 L66,28 Q69,28 69,31 L69,77 Q69,80 66,80 L36,80 Q34,80 34,78 L34,30 Q34,28 36,28 Z"
        android:strokeWidth="1.6"
        android:strokeColor="#334155" />

    <!-- Mint light spill inside the ajar doorway opening -->
    <path android:pathData="M53,29 L68,29 L68,79 L53,79 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="68"
                android:endY="54"
                android:startX="53"
                android:startY="54"
                android:type="linear">
                <item
                    android:color="#0000FF94"
                    android:offset="0.0" />
                <item
                    android:color="#4D00EEDA"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- White door slab slightly ajar with ViveReply ink keyline -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34.5,29 L59,34 L59,74 L34.5,79 Z"
        android:strokeWidth="2.4"
        android:strokeColor="#0F172A"
        android:strokeLineJoin="round" />

    <!-- Subtle inner door panel keyline -->
    <path
        android:fillColor="#00000000"
        android:pathData="M39,34.5 L54,37.5 L54,49.5 L39,48.5 Z"
        android:strokeWidth="1.1"
        android:strokeColor="#CBD5E1"
        android:strokeLineJoin="round" />

    <!-- Door latch handle -->
    <path
        android:fillColor="#0F172A"
        android:pathData="M54.5,54 m-1.8,0 a1.8,1.8 0 1,0 3.6,0 a1.8,1.8 0 1,0 -3.6,0" />

    <!-- Ink keyline halo under the emerging mint check -->
    <path
        android:fillColor="#00000000"
        android:pathData="M47.5,54 L56.5,63 L75.5,41.5"
        android:strokeWidth="8.8"
        android:strokeColor="#0F172A"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Mint gradient checkmark emerging from the ajar door -->
    <path
        android:fillColor="#00000000"
        android:pathData="M47.5,54 L56.5,63 L75.5,41.5"
        android:strokeWidth="5.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="75.5"
                android:endY="41.5"
                android:startX="47.5"
                android:startY="60"
                android:type="linear">
                <item
                    android:color="#00FF94"
                    android:offset="0.0" />
                <item
                    android:color="#00EEDA"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
