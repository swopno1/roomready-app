<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Secrets must never leave the device via backup. -->
        <exclude domain="sharedpref" path="roomready_credentials.xml" />
        <!-- Local photo files and refs are meaningless on restore. -->
        <exclude domain="sharedpref" path="roomready_photos.xml" />
        <exclude domain="file" path="cleaning_photos/" />
    </cloud-backup>
    <device-transfer>
        <!-- Secrets must never leave the device via transfer. -->
        <exclude domain="sharedpref" path="roomready_credentials.xml" />
        <!-- Local photo files and refs are meaningless on restore. -->
        <exclude domain="sharedpref" path="roomready_photos.xml" />
        <exclude domain="file" path="cleaning_photos/" />
    </device-transfer>
</data-extraction-rules>
