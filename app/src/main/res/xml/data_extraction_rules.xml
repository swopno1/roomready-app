<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Secrets must never leave the device via backup. -->
        <exclude domain="sharedpref" path="roomready_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Secrets must never leave the device via transfer. -->
        <exclude domain="sharedpref" path="roomready_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
