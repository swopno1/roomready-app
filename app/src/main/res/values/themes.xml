<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.RoomReady.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vivereply_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.RoomReady</item>
        <item name="android:windowBackground">@drawable/splash_background_compat</item>
    </style>

    <style name="Theme.RoomReady" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/warm_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
